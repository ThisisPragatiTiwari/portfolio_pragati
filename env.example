# Copy this file to `.env` for local dev (`vercel dev`), and add the same
# values in Vercel → Project → Settings → Environment Variables for production.

# --- Email (Resend: resend.com → API Keys) ---
RESEND_API_KEY=re_xxxxxxxxxxxx
# Inbox that receives contact form messages. Until you verify a domain on
# Resend, this must be the email you signed up to Resend with.
TO_EMAIL=you@example.com
# Until you verify a domain, use Resend's shared testing sender:
FROM_EMAIL=Portfolio <onboarding@resend.dev>

# --- Bot protection (Cloudflare Turnstile, optional but recommended) ---
# Secret key: server-side only.
TURNSTILE_SECRET_KEY=
# Site key: public, exposed to the browser (the VITE_ prefix does that).
VITE_TURNSTILE_SITE_KEY=
